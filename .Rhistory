# set your working direotires to were the data is
wd.in  <- "~/ActiveProjects/MAMM-Batz Package/4 Current  test data"
wd.out <- "~/ActiveProjects/MAMM-Batz Package/7 test outputs"
wd.summary <- "~/ActiveProjects/MAMM-Batz Package/4 Current  test data/meta files"
library(Batz)
setwd(wd.in )
batz.datawrangler_load.files(
# selects the directory that the summary xlxs or csv files are in
dir.load = wd.summary,
# If true it will also scan through and load any subdirectories
dir.sub = FALSE,
# If TRUE, exact duplicate rows are removed from WITHIN each individual
# data frame
duplicates.remove = TRUE,
# If TRUE will getenrate a log file that outlines what happned with each
# attempted load, successful or otherwise and why. Used for debugging
log.file = FALSE,
# If true, when loading a file, function checks the headers of the file vs
# the headers of objects already loaded. If there is 100% match, then
# the new file is just appenned to the bottom of the existing object
header.match = FALSE,
# If true, when two files have the exact same name, don't load the second
duplicates.skip = FALSE,
# maxium number of objects created, prevents crashes if a folder and/or
# sub folders with a large number of files are accidentally selected
objects.max = 25
)
