# STEP 2: LOAD AND FORMATE ALL FILES
### Load the master data file or copy it across from another source
plfr.aruday.ma$aru.lbl      <- BRIBAT.aru_label(plfr.aruday.ma$aru)
plfr.suntimes.ma$aru.lbl <- BRIBAT.aru_label(plfr.suntimes.ma$aru)
plfr.aruday.ma$aru.lbl <- BRIBAT.aru_label(plfr.aruday.ma$aru)
##### format each of the variables unto the correct format ####################
plfr.aruday.ma$xaxe               <- as.Date(plfr.aruday.ma$date,
tryFormats = c("%Y-%m-%d", "%m/%d/%Y"))
plfr.aruday.ma$obs                <- as.numeric(plfr.aruday.ma$obs)
plfr.aruday.ma$call.unix.max      <- as.numeric(plfr.aruday.ma$call.unix.max)
plfr.aruday.ma$call.unix.min      <- as.numeric(plfr.aruday.ma$call.unix.min)
plfr.aruday.ma$chartname          <- plfr.aruday.ma$aru
plfr.aruday.ma$spp.lab            <- BRIbat.us4_common(plfr.aruday.ma$sppid)
plfr.aruday.ma$date.mon <- paste(plfr.aruday.ma$date, "12:00:00")
plfr.aruday.ma$date.mon <- as.POSIXlt(plfr.aruday.ma$date.mon,
tz=time.zone)
plfr.aruday.ma$mins.mdnt.min <-
(plfr.aruday.ma$date.unix + 21600 - plfr.aruday.ma$call.unix.min)/60
plfr.aruday.ma$mins.mdnt.max <-
(plfr.aruday.ma$date.unix + 21600 -  plfr.aruday.ma$call.unix.max)/60
plfr.aruday.ma$datetime.min <- as.POSIXlt(plfr.aruday.ma$call.unix.min)
plfr.aruday.ma$datetime.max <- as.POSIXlt(plfr.aruday.ma$call.unix.max)
plfr.aruday.ma$yaxe.suns <- as.numeric(difftime(plfr.aruday.ma$datetime.min,
plfr.aruday.ma$date.mon,
units = "mins"))
plfr.aruday.ma$yaxe.sunr <- as.numeric(difftime(plfr.aruday.ma$datetime.max,
plfr.aruday.ma$date.mon,
units = "mins"))
####### Check that the xaxes values are correct  ######
range(plfr.aruday.ma$xaxe)
range(plfr.aruday.ma$obs  )
# set the max number of calls on the Y axis and the labels for the Y axes
maxcall <- 230
calls.labels <- c(0,2,8,20,50,maxcall)
calls.labels <- c(0,2,8,25,75,maxcall)
# Calculate the log of all obs and scale it between 0 and 1
plfr.aruday.ma$obs.log <- log(plfr.aruday.ma$obs+1)
plfr.aruday.ma$obs.logscale <- BRIbat.trans_scale.data(plfr.aruday.ma$obs.log,
c(0,1),
c(0,log(maxcall+1)))
calls.labels.log <- log(calls.labels+1)
call.axis <- BRIbat.trans_scale.data(calls.labels.log,
c(0,1),
c(0,log(maxcall+1)))
aru.axis   <- BRIbat.trans_scale.data(seq(0,100,20),
c(0,1),
c(0,100))
plfr.aruday.ma$yaxe <- plfr.aruday.ma$obs.logscale
plfr.aruday.ma$facpan.var <- plfr.aruday.ma$spp.lab
plfr.aruday.ma$facpan.lbl <- plfr.aruday.ma$facpan.var
plfr.aruday40kmyo.ma <- plfr.aruday.ma[plfr.aruday.ma$facpan.var %in% "40khzmyo",]
plfr.aruday40kmyo.ma$facpan.var <-  "All detections"
plfr.aruday40kmyo.sub <- plfr.aruday40kmyo.ma
plfr.aruday.sub <- plfr.aruday.ma[plfr.aruday.ma$facpan.var %in% spp.plot,]
###############################################################################
# Step 3: Plot data: For each time period (night, week etc)
#  Plot 1: Total number of calls for target species and 40kmyos
#  Plot 2: Earliest and latest detection each
###############################################################################
plfr.aruday.sub        <- plfr.aruday.ma[plfr.aruday.ma$spp.lab %in% facpan,]
plfr.aruday40kmyo.sub  <- plfr.aruday40kmyo.ma[plfr.aruday40kmyo.ma$spp.lab %in% "40khzmyo",]
#plfr.suntimes.ma$aru.lbl <- BRIBAT.aru_label(plfr.suntimes.ma$aru)
aru.lbl <- unique(plfr.aruday.sub$aru.lbl)
### Plot2
for(a in 1:length(aru.lbl)){
pl.aruday        <- plfr.aruday.sub[plfr.aruday.sub$aru.lbl==aru.lbl[a],]
pl.aruday40kmyo  <- plfr.aruday40kmyo.sub[plfr.aruday40kmyo.sub$aru.lbl==aru.lbl[a],]
facpan.varlen <- length(unique(pl.aruday$facpan.var))
facpan.numcol <- 3
facpan.numrow <- 3
plot.name <- paste("Number of bat calls detected at", aru.lbl[a],
"between\n", date.start, "and",date.end)
suppressWarnings(print(
ggplot()+
geom_col(data=pl.aruday,       aes( x = xaxe , y= yaxe), fill ="gray70",
na.rm = TRUE)+
geom_col(data=pl.aruday40kmyo, aes( x = xaxe , y = yaxe, fill ="40kHzMyo"),
na.rm = TRUE)+
#   geom_col(data=pl.aruday.sub2,  aes( xaxe , yaxe), fill ="black" )+
# set the number of facets (subplots) and
facet_wrap(~facpan.var, ncol=facpan.numcol, nrow=facpan.numrow)+
# # set the limits of the Y axes and set the labels, breaks and labels
scale_y_continuous(limits = c(0,1.1),
breaks= call.axis,
labels = calls.labels,
name = "Number of Observations"
)+
# # #
#
scale_x_date(breaks = xaxe.interval ,
date_labels = xaxe.labelformat,
name = "\nMonitoring Night",
#   limits = c(date.start-1,date.end+1)
)+
# # #
labs(title = plot.name)+
scale_fill_manual(values = c("40kHzMyo"= "black"),
labels = c("40kHzMyo"),
name = c(""))+
#  theme_grey()+
theme_bw()+
force_panelsizes(
total_width =  unit(facpan.wid * facpan.numcol, "inch"),
total_height = unit(facpan.hgt * facpan.numrow, "inch") )+
theme_bw()+
theme(plot.title       = element_text(size = plot.title.size, hjust = 0 ),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
legend.title     = element_text(size = legend.title.size),
legend.text      = element_text(size = legend.text.size),
axis.title       = element_text(size = axis.title.size),
axis.text        = element_text(size = axis.text.size),
strip.text       = element_text(size = axis.title.size),
legend.position  = "bottom",
#legend.position = "none",
strip.background = element_blank() )
))
setwd(wd.charts)
plot.name <- paste("Number of bat calls detected at", aru.lbl[a],
"between", date.start, "and",date.end,
format(Sys.time(), "%Y%m%d%H%M%S"), ".png")
# work out how to calulate before the save before the save
plwid <- (facpan.wid * facpan.numcol) + facpan.widyaxe
plhgt <- (facpan.hgt * facpan.numrow) + facpan.widxaxe
suppressWarnings(
ggsave( plot.name,
width  = plwid,
height = plhgt+1,
units  = "in",
dpi    = 300)
)
# second plot: earlies and latest time
###
header <-   c("facpan.var","date","xaxe","aru","lat","long","time.zone","suns",
"suns.unix","sunr","sunr.unix","sunr.mon","sunr.mon.unix", "date.mon","yaxe.suns"    ,
"yaxe.sunr" )
plfr.suntimes$aru.lbl <- BRIBAT.aru_label(plfr.suntimes$aru)
pl.suntimes <- plfr.suntimes[plfr.suntimes$aru.lbl == aru.lbl[a],]
#  Plot 1: Total number of calls for target species and 40kmyos
plot.name <- paste("Earliest and latest bat calls detected at", aru.lbl[a],
"\nbetween", date.start, "and",date.end)
pl.aruday$yaxe.suns[is.na(pl.aruday$yaxe.suns)]<-720
pl.aruday$yaxe.sunr[is.na(pl.aruday$yaxe.sunr)]<-720
pl.aruday40kmyo$yaxe.suns[is.na(pl.aruday40kmyo$yaxe.suns)]<-720
pl.aruday40kmyo$yaxe.sunr[is.na(pl.aruday40kmyo$yaxe.sunr)]<-720
pl.suntimes$mdnt <- 720
suppressWarnings(print(
ggplot()+
geom_line(data = pl.suntimes,
aes(x =  xaxe, y = mdnt, linetype = "Midnight"))+
#
geom_line(data = pl.suntimes,
aes(x =  xaxe, y =   yaxe.sunr, linetype = "Dawn"),
color = "blue")+
geom_line(data = pl.suntimes,
aes(x =  xaxe, y = yaxe.suns, linetype ="Dusk"),
color ="red")+
geom_crossbar(data= pl.aruday, color = "black",
aes(x = xaxe, y = 720,
ymin = yaxe.suns, ymax = yaxe.sunr),
fill = "gray70", linewidth = 0.2) +
geom_crossbar(data= pl.aruday40kmyo,
aes(x = xaxe, y = 720,
ymin = yaxe.suns, ymax = yaxe.sunr, fill ="40kHzMyo"),
linewidth = 0.2) +
# #
# #geom_hline(yintercept = 294, col = "red", show.legend = T )+
scale_linetype_manual(values = c("Midnight" = "solid",
"Dawn" = "dashed",
"Dusk" = "dashed"
),
name = c(""))+
facet_wrap(~facpan.var, ncol=facpan.numcol)+
scale_y_continuous(limits = c(0,1440),
breaks= seq(0,1440,180 ),
labels = c("Noon","15:00", "18:00","21:00",
"Midnight","03:00","06:00","09:00", "Noon"),
name = "\nHour of Monitoring",
)+
scale_fill_manual(values = c("40kHzMyo"= "black"),
labels = c("40kHzMyo"),
name = c(""))+
scale_x_date(breaks = xaxe.interval ,
date_labels = xaxe.labelformat,
name = "\nMonitoring Night",
limits = c(date.start-1,date.end+1)
)+
# #
labs(title = plot.name)+
#  theme_grey()+
theme_bw()+
force_panelsizes(
total_width =  unit(facpan.wid * facpan.numcol, "inch"),
total_height = unit(facpan.hgt * facpan.numrow, "inch") )+
theme_bw()+
theme(plot.title       = element_text(size = plot.title.size, hjust = 0 ),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
legend.title     = element_text(size = legend.title.size),
legend.text      = element_text(size = legend.text.size),
axis.title       = element_text(size = axis.title.size),
axis.text        = element_text(size = axis.text.size),
strip.text       = element_text(size = axis.title.size),
legend.position  = "bottom",
#legend.position = "none",
strip.background = element_blank() )
))
setwd(wd.charts)
plot.name <- paste("Earlies and lastest ball calls detected at", aru.lbl[a],
"between", date.start, "and",date.end,
format(Sys.time(), "%Y%m%d%H%M%S"), ".png")
# work out how to calulate before the save before the save
# work out how to calulate before the save before the save
plwid <- (facpan.wid * facpan.numcol) + facpan.widyaxe
plhgt <- (facpan.hgt * facpan.numrow) + facpan.widxaxe
suppressWarnings(
ggsave( plot.name,
