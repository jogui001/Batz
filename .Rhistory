library(ggplot2)
# aes.default settings (or just read.csv("plotopts_heatmap.csv", stringsAsFactors = FALSE))
aes.default <- data.frame(
category = c("Fill", "Fill", "Axes", rep("Text", 5), "Theme", rep("Save", 6)),
parameter = c("fill.max", "fill.colors", "ybreak.hours",
"plot.title.size", "axis.title.size", "axis.text.size",
"legend.title.size", "legend.text.size", "panel.border.linewidth",
"ggsave.dpi", "ggsave.units", "ggsave.width.pad", "ggsave.height.pad",
"plot.width", "plot.height"),
default.value = c("100", "#cde2fb;#9ec5f4;#6da7ec;#3987e5;#256abf;#184f95;#0d366b",
"2", "12", "12", "11", "11", "10", "0.5",
"150", "in", "0", "0", "10", "7"),
overide.value = "",
notes = "",
stringsAsFactors = FALSE
)
# data - one row per detection, with a monitoring-night date and a clock time
set.seed(1)
n <- 200
dates <- sample(seq(as.Date("2026-06-01"), as.Date("2026-06-10"), by = "day"), n, replace = TRUE)
times <- sprintf("%02d:%02d", sample(0:23, n, replace = TRUE), sample(0:59, n, replace = TRUE))
data <- data.frame(monnight.date = dates, time = times, stringsAsFactors = FALSE)
res <- batz.plotactivity_heatmap(
data = data,
aes.default = aes.default,
project.name = "acme.wetlands",
site.label = "SITE1",
dir.save = getwd()
)
res$data     # the complete night x bin grid actually plotted
res$ggplot   # the ggplot object
