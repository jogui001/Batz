height = plhgt+1,
units  = "in",
dpi    = 300)
)
}
###############################################################################
# Step 3: Plot data:
#  fig 1: plot sm4 activity map
###############################################################################
if(mon.nght == TRUE){
plfr.suntimes.ma$time.ref <-  plfr.suntimes.ma$date.mon
}else{
plfr.suntimes.ma$time.ref <-  plfr.suntimes.ma$date.cal
}
plfr.suntimes.ma$yaxe.suns <- as.numeric(difftime(plfr.suntimes.ma$suns,
plfr.suntimes.ma$time.ref,
units = "mins"))
plfr.suntimes.ma$yaxe.sunr <- as.numeric(difftime(plfr.suntimes.ma$sunr.mon,
plfr.suntimes.ma$time.ref,
units = "mins"))
plfr.suntimes.ma$mdnt   <- 720
plfr.suntimes.ma$aru.lbl <- BRIBAT.aru_label(plfr.suntimes.ma$aru)
plfr.sm4activity.ma$xaxe  <- as.Date(plfr.sm4activity.ma$date.mon,
tryFormats = c("%m/%d/%Y", "%Y-%m-%d"))
plfr.sm4activity.ma$yaxe  <- plfr.sm4activity.ma$mins2.noon.mon
for(a in 1:length(aru.lbl)){
pl.aruactivity <- plfr.sm4activity.ma[plfr.sm4activity.ma$aru.lbl==aru.lbl[a],]
pl.aruactivity <- data.frame(pl.aruactivity)
sunregion <-  unique(pl.aruactivity$sunregion)
pl.suntimes <- plfr.suntimes.ma[plfr.suntimes.ma$aru.lbl == aru.lbl[a],]
pl.suntimes <- unique(pl.suntimes)
pl.aruactivity$yaxe <- pl.aruactivity$hour.quart.mon*60
suppressWarnings(print(
ggplot(pl.aruactivity, aes(x = xaxe, y=yaxe) )+
geom_tile(date= pl.aruactivity, aes(x = xaxe, y=yaxe, fill=mins.oper),
color= "white", linewidth=0.1) +
scale_fill_viridis_c(name="SM4Bat Operational \nMinutes at \n15min Intervals",
option ="D",na.value="white")+
geom_line(data= pl.suntimes, aes(x=xaxe, y = yaxe.suns,
color = "Dusk"), lty = 5)+
geom_line(data= pl.suntimes, aes(x=xaxe, y = mdnt,
color = "Midnight"))+
geom_line(data= pl.suntimes, aes(x=xaxe, y = yaxe.sunr,
color = "Dawn"), lty = 5)+
scale_color_manual(name = "", values = c("Dusk" = "blue",
"Midnight" = "black",
"Dawn" = "red"))+
scale_y_continuous(limits = c(0,1440),
breaks = seq(0,1440,180),
labels = c("Noon","15:00", "18:00","21:00",
"Midnight","03:00","06:00","09:00", "Noon"),
name = "\nHour of Monitoring")+
scale_x_date(breaks = xaxe.interval ,
date_labels = xaxe.labelformat,
name = "\nMonitoring Night",
limits = c(date.start-2, date.end+2) )+
labs(title = paste(aru.lbl[a],  "Operational Time Heatmap"))+
theme_bw()+
theme( panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
# plot.background = "grey",
# legend.key.height = unit(.01, 'in'), #change legend key height
legend.position = "bottom",
#legend.position = "none",
strip.background = element_blank() )
))
setwd(wd.charts)
plot.name <- paste( aru.lbl[a],format(Sys.time(), "%Y%m%d%H%M"),".png")
suppressWarnings(
ggsave( plot.name,
width = 6.5 ,
height = 7,
units = "in",
dpi = 300)
)
